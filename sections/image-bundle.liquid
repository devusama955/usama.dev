{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  .image-bundle {
    display: grid;
    gap: {{ section.settings.gap | times: 0.75 | round: 0 }}px;
  }
  
  @media screen and (min-width: 750px) {
    .image-bundle {
      gap: {{ section.settings.gap }}px;
    }
  }
  
  .image-bundle__item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    display: block;
  }
  
  .image-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  
  .image-bundle__item:hover .image-bundle__image {
    transform: scale({{ section.settings.hover_scale | divided_by: 100.0 }});
  }
  
  .image-bundle__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
    text-align: center;
  }
  
  .image-bundle__item:hover .image-bundle__overlay {
    opacity: 1;
  }
  
  .image-bundle__product-title {
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px 0;
  }
  
  .image-bundle__product-price {
    color: #fff;
    font-size: 14px;
    margin-bottom: 10px;
  }
  
  .image-bundle__product-description {
    color: #ddd;
    font-size: 12px;
    line-height: 1.5;
    margin-bottom: 15px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  
  .image-bundle__view-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(255,255,255,0.9);
    color: #000;
    width: 50px;
    height: 50px;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .image-bundle__item:hover .image-bundle__view-btn {
    opacity: 1;
  }
  
  .image-bundle__view-btn svg {
    width: 24px;
    height: 24px;
  }
{%- endstyle -%}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-bundle__title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    <div 
      class="image-bundle"
      style="grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);"
    >
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product == empty -%}
          {%- continue -%}
        {%- endif -%}
        
        {%- assign bundle_image = block.settings.image -%}
        {%- if bundle_image == blank -%}
          {%- assign bundle_image = product.featured_image -%}
        {%- endif -%}
        
        <a href="{{ product.url }}" class="image-bundle__item" {{ block.shopify_attributes }}>
          {%- if bundle_image != blank -%}
            <img
              src="{{ bundle_image | image_url: width: 600 }}"
              alt="{{ bundle_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="{{ 600 | divided_by: bundle_image.aspect_ratio | round }}"
              class="image-bundle__image"
            >
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg image-bundle__image' }}
          {%- endif -%}
          
          <div class="image-bundle__overlay">
            <h3 class="image-bundle__product-title">{{ product.title | escape }}</h3>
            
            <p class="image-bundle__product-price">
              {%- render 'price', product: product, use_variant: true, show_badges: true -%}
            </p>
            
            {%- if product.description != blank -%}
              <p class="image-bundle__product-description">{{ product.description | strip_html | truncate: 100 }}</p>
            {%- endif -%}
            
            <button type="button" class="image-bundle__view-btn" aria-label="View {{ product.title }}">
              <span class="svg-wrapper">
                {{- 'icon-eye.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var viewBtns = document.querySelectorAll('.image-bundle__view-btn');
    viewBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var link = this.closest('.image-bundle__item');
        if (link) {
          window.location.href = link.href;
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Image Bundle",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Image Bundle",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns (Desktop)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Columns (Mobile)"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "label": "Gap"
    },
    {
      "type": "range",
      "id": "hover_scale",
      "min": 100,
      "max": 110,
      "step": 1,
      "default": 105,
      "label": "Hover Scale (%)"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)",
          "info": "Leave blank to use product's featured image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Bundle",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}

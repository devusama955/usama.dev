{% assign fabrics = product.metafields.custom.best_fabric.value %}

<div class="best-fabric-wrapper">

  {{ fabrics | json }}

  {% if fabrics != blank %}

    {% for fabric in fabrics %}
      
      <div class="fabric-item">

        <h3>{{ fabric.system.title }}</h3>

        <p>{{ fabric.description.value }}</p>

      </div>

    {% endfor %}

  {% endif %}

</div>

{% schema %}
{
  "name": "Best Fabric",
  "settings": [],
  "presets": [
    {
      "name": "Test Metaobject"
    }
  ]
}
{% endschema %}
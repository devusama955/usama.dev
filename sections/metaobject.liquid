{% assign fabrics = product.metafields.custom.best_fabric.value %}

<div class="best-fabric-wrapper">

  {% if fabrics != blank %}

    {% for fabric in fabrics %}
      <div class="fabric-item">
        
        {% if fabric.title != blank %}
          <h3>{{ fabric.title }}</h3>
        {% endif %}

        {% if fabric.description != blank %}
          <p>{{ fabric.description }}</p>
        {% endif %}

      </div>
    {% endfor %}

  {% else %}
    <p>No fabrics found.</p>
  {% endif %}

</div>

{% schema %}
{
  "name": "Best Fabric",
  "tag": "section",
  "class": "best-fabric-section",
  "settings": [],
  "presets": [
    {
      "name": "test meta object"
    }
  ]
}
{% endschema %}
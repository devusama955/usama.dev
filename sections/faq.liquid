{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .faq-section-{{ section.id }} {
    background: {{ section.settings.background_color | default: 'transparent' }};
    {% if section.settings.gradient_start_color and section.settings.gradient_end_color %}
      background: linear-gradient(135deg, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_end_color }});
    {% endif %}
    color: {{ section.settings.text_color | default: 'inherit' }};
  }

  .faq-question-{{ section.id }} {
    font-size: {{ section.settings.question_font_size }}rem !important;
    color: {{ section.settings.question_text_color }} !important;
  }

  .faq-answer-{{ section.id }} {
    font-size: {{ section.settings.answer_font_size }}rem !important;
    color: {{ section.settings.answer_text_color }} !important;
  }

  .faq-section-{{ section.id }} .accordion__title {
    font-size: {{ section.settings.question_font_size }}rem;
    color: {{ section.settings.question_text_color }};
  }

  .faq-section-{{ section.id }} .accordion__content {
    color: {{ section.settings.answer_text_color }};
    font-size: {{ section.settings.answer_font_size }}rem;
  }

  .faq-section-{{ section.id }} .svg-wrapper {
    fill: {{ section.settings.icon_color }};
  }
{%- endstyle -%}

<div class="faq-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient page-width section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <h2 class="faq-heading inline-richtext {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_font_size }}rem;">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}
  <div class="faq-accordion-wrapper{% if section.settings.layout == 'grid' %} grid grid--2-col-tablet{% endif %}">
    {%- for block in section.blocks -%}
      <div class="faq-item{% if section.settings.layout == 'grid' %} grid__item{% endif %}">
        <div class="accordion" {{ block.shopify_attributes }}>
          <details id="FAQ-{{ block.id }}-{{ section.id }}">
            <summary id="FAQ-Summary-{{ block.id }}-{{ section.id }}">
              {%- if block.settings.icon != blank -%}
                {% render 'icon-accordion', icon: block.settings.icon %}
              {%- endif -%}
              <h3 class="faq-question-{{ section.id }} accordion__title">
                {{ block.settings.question }}
              </h3>
              <span class="icon-caret">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="faq-answer-{{ section.id }} accordion__content rte" id="FAQ-Content-{{ block.id }}-{{ section.id }}" role="region">
              {{ block.settings.answer }}
            </div>
          </details>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gradient_start_color",
      "label": "Gradient start color"
    },
    {
      "type": "color",
      "id": "gradient_end_color",
      "label": "Gradient end color"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "FAQ heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.0,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading font size",
      "default": 2.5
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading style"
    },
    {
      "type": "header",
      "content": "Question text"
    },
    {
      "type": "range",
      "id": "question_font_size",
      "min": 1.0,
      "max": 3.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Question font size",
      "default": 1.3
    },
    {
      "type": "color",
      "id": "question_text_color",
      "label": "Question text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Answer text"
    },
    {
      "type": "range",
      "id": "answer_font_size",
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Answer font size",
      "default": 1.1
    },
    {
      "type": "color",
      "id": "answer_text_color",
      "label": "Answer text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "stack",
          "label": "Stacked"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "stack",
      "label": "Layout"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            {
              "value": "none",
              "label": "No icon"
            },
            {
              "value": "question_mark",
              "label": "Question mark"
            },
            {
              "value": "chat_bubble",
              "label": "Chat bubble"
            },
            {
              "value": "check_mark",
              "label": "Check mark"
            },
            {
              "value": "plus",
              "label": "Plus"
            },
            {
              "value": "chevron",
              "label": "Chevron"
            }
          ],
          "label": "Icon (per item override)",
          "default": "question_mark"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Describe your return policy here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.conditional-section {
  padding: 50px 20px;
}
.conditional-container {
  max-width: 1200px;
  margin: 0 auto;
}
.conditional-block {
  margin-bottom: 40px;
  text-align: center;
}
.conditional-block img {
  max-width: 100%;
  height: auto;
  margin-bottom: 15px;
}
.conditional-block h2 {
  font-size: 28px;
  margin-bottom: 10px;
}
.conditional-block p {
  font-size: 16px;
  margin-bottom: 15px;
}
.conditional-block a {
  display: inline-block;
  padding: 10px 20px;
  background: black;
  color: white;
  text-decoration: none;
}
{% endstyle %}

<div class="conditional-section">
  <div class="conditional-container">

    {% for block in section.blocks %}
      
      {% assign show_block = true %}

      {%- comment -%} Checkbox condition {%- endcomment -%}
      {% if block.settings.enable_block == false %}
        {% assign show_block = false %}
      {% endif %}

      {%- comment -%} Date condition {%- endcomment -%}
      {% if block.settings.start_date != blank %}
        {% assign today = 'now' | date: '%s' %}
        {% assign start = block.settings.start_date | date: '%s' %}
        {% if today < start %}
          {% assign show_block = false %}
        {% endif %}
      {% endif %}

      {% if show_block %}
        <div class="conditional-block" {{ block.shopify_attributes }}>
          
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="">
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link }}">
              {{ block.settings.button_label }}
            </a>
          {% endif %}

        </div>
      {% endif %}

    {% endfor %}

  </div>
</div>
{% schema %}
{
  "name": "Conditional Content",
  "settings": [],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_block",
          "label": "Enable this block",
          "default": true
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "Start Date (YYYY-MM-DD)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Conditional Content"
    }
  ]
}
{% endschema %}
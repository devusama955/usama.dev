<div class="test-object-wrapper page-width">
  {%- liquid 
    # Change 'custom.your_metafield_key' to your actual product metafield key
    assign test_object = product.metafields.custom.test_object_link.value 
  -%}

  {%- if test_object != blank -%}
    <div class="test-object-content" style="border: 1px solid #e8e8e8; padding: 30px; border-radius: 12px; margin: 20px 0;">
      
      {%- if test_object.heading != blank -%}
        <h2 style="margin-top: 0;">{{ test_object.heading }}</h2>
      {%- endif -%}

      {%- if test_object.discraptions != blank -%}
        <div class="test-object-description" style="line-height: 1.6;">
          {{ test_object.discraptions | newline_to_br }}
        </div>
      {%- endif -%}

      {%- if test_object.image != blank -%}
        <div class="test-object-image" style="margin-top: 20px;">
          {{ test_object.image | image_url: width: 1000 | image_tag: 
            loading: 'lazy', 
            style: 'width: 100%; height: auto; border-radius: 8px;' 
          }}
        </div>
      {%- endif -%}
      
    </div>
  {%- elsif request.design_mode -%}
    <div style="padding: 20px; background: #fdfdfd; border: 1px dashed #ccc; text-align: center;">
      <p>Assign a <b>Test Object</b> to this product in the Admin to see content here.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Test Object Display",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "This section automatically displays data from the Metaobject linked to this product."
    }
  ],
  "presets": [
    {
      "name": "Test Object Display"
    }
  ]
}
{% endschema %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.layout == 'grid' -%}
    .advanced-video__grid {
      display: grid;
      gap: {{ section.settings.gap | times: 0.75 | round: 0 }}px;
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
    
    @media screen and (min-width: 750px) {
      .advanced-video__grid {
        gap: {{ section.settings.gap }}px;
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      }
    }
  {%- endif -%}

  {%- if section.settings.layout == 'carousel' -%}
    .advanced-video__carousel {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ section.settings.gap | times: 0.75 | round: 0 }}px;
      padding-bottom: 10px;
    }
    
    @media screen and (min-width: 750px) {
      .advanced-video__carousel {
        gap: {{ section.settings.gap }}px;
      }
    }
    
    .advanced-video__carousel-item {
      flex: 0 0 calc(100% - {{ section.settings.gap | times: 0.75 | round: 0 }}px);
      scroll-snap-align: start;
    }
    
    @media screen and (min-width: 750px) {
      .advanced-video__carousel-item {
        flex: 0 0 calc({{ 100 | divided_by: section.settings.carousel_slides }}% - {{ section.settings.gap }}px);
      }
    }
  {%- endif -%}

  .advanced-video__item {
    position: relative;
    overflow: hidden;
  }

  .advanced-video__item--background {
    min-height: {{ section.settings.background_height }}px;
  }

  .advanced-video__item--background .advanced-video__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .advanced-video__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.text_position | default: 'center' }};
    align-items: {{ section.settings.text_align | default: 'center' }};
    padding: 40px;
    {%- if section.settings.overlay_opacity > 0 -%}
      background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    {%- endif -%}
  }

  {%- if section.settings.layout != 'carousel' -%}
    .advanced-video__content {
      position: relative;
      z-index: 2;
      text-align: {{ section.settings.text_align | default: 'center' }};
    }
  {%- endif -%}

  .advanced-video__title {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.title_size | default: 32 }}px;
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .advanced-video__description {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.description_size | default: 16 }}px;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .advanced-video__price {
    color: {{ section.settings.text_color }};
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 15px;
  }

  .advanced-video__product-title {
    color: {{ section.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 5px 0;
  }

  .advanced-video__text-overlay {
    margin-bottom: 20px;
  }

  .advanced-video__poster {
    cursor: pointer;
  }
  
  .slider-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }
  
  .slider-button {
    background: rgba(255,255,255,0.8);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .slider-button svg {
    width: 20px;
    height: 20px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="advanced-video__section-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.layout == 'grid' -%}
      <div class="advanced-video__grid">
        {%- for block in section.blocks -%}
          {%- render 'advanced-video-item', block: block, section: section, forloop: forloop -%}
        {%- endfor -%}
      </div>

    {%- elsif section.settings.layout == 'carousel' -%}
      <div class="advanced-video__carousel" id="Carousel-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="advanced-video__carousel-item">
            {%- render 'advanced-video-item', block: block, section: section, forloop: forloop -%}
          </div>
        {%- endfor -%}
      </div>
      
      {%- if section.settings.layout == 'carousel' and section.blocks.size > 1 -%}
        <div class="slider-buttons">
          <button type="button" class="slider-button" aria-label="Previous" data-slide="prev">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <button type="button" class="slider-button" aria-label="Next" data-slide="next">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- for block in section.blocks -%}
        {%- render 'advanced-video-item', block: block, section: section, forloop: forloop -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{%- if section.settings.layout == 'carousel' -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var carousel = document.getElementById('Carousel-{{ section.id }}');
    if (!carousel) return;
    
    var prevBtn = carousel.parentElement.querySelector('[data-slide="prev"]');
    var nextBtn = carousel.parentElement.querySelector('[data-slide="next"]');
    
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        carousel.scrollBy({ left: -carousel.offsetWidth, behavior: 'smooth' });
      });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        carousel.scrollBy({ left: carousel.offsetWidth, behavior: 'smooth' });
      });
    }
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Advanced Video",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Videos",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "stacked", "label": "Stacked" },
        { "value": "single", "label": "Single (Full Width)" }
      ],
      "default": "grid",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Columns (Desktop)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1,
      "label": "Columns (Mobile)"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "label": "Gap"
    },
    {
      "type": "range",
      "id": "carousel_slides",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Slides to Show"
    },
    {
      "type": "header",
      "content": "Text Styling"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "flex-start", "label": "Left" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center",
      "label": "Text Alignment"
    },
    {
      "type": "select",
      "id": "text_position",
      "options": [
        { "value": "center", "label": "Middle" },
        { "value": "flex-start", "label": "Top" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Text Position"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 10,
      "default": 40,
      "label": "Overlay Opacity (%)"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 32,
      "label": "Title Size"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 2,
      "default": 16,
      "label": "Description Size"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "limit": 6,
      "settings": [
        {
          "type": "header",
          "content": "Video"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Upload Video"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "label": "or Video URL (YouTube/Vimeo)"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover Image"
        },
        {
          "type": "checkbox",
          "id": "enable_loop",
          "default": true,
          "label": "Loop Video"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "default": false,
          "label": "Autoplay"
        },
        {
          "type": "header",
          "content": "Text Overlay"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "header",
          "content": "Shoppable Product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Link Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advanced Video",
      "blocks": [
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
